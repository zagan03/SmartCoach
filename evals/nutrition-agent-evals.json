{
  "description": "Evaluation cases for the SmartCoach Nutrition/Progress Agent (Agent 2).",
  "version": "1.0.0",
  "agent": "nutrition-progress",
  "evaluationCriteria": [
    "response is not empty",
    "response contains calories field (number)",
    "response contains protein field (number)",
    "response contains hydration field (string with 'L')",
    "response contains progressFeedback (non-empty string)",
    "response contains mealPlanSummary (non-empty string)",
    "calories never below 1200 kcal (guardrail)",
    "adjustment is within ±300 kcal",
    "response includes generatedAt ISO timestamp",
    "response does not contain dangerous dietary advice"
  ],
  "cases": [
    {
      "id": "NA-001",
      "description": "Weight loss goal — on track progress",
      "input": {
        "profile": {
          "name": "Ana",
          "gender": "female",
          "weight": 70,
          "height": 165,
          "age": 28,
          "activityLevel": "moderate",
          "goal": "weight_loss",
          "targetWeight": 62,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u1", "date": "2024-01-14", "weight": 70.5, "created_at": "" },
          { "id": "2", "user_id": "u1", "date": "2024-01-12", "weight": 70.8, "created_at": "" },
          { "id": "3", "user_id": "u1", "date": "2024-01-10", "weight": 71.0, "created_at": "" },
          { "id": "4", "user_id": "u1", "date": "2024-01-07", "weight": 71.5, "created_at": "" },
          { "id": "5", "user_id": "u1", "date": "2024-01-05", "weight": 71.8, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "calories": { "operator": "greaterThanOrEqual", "value": 1200 },
        "protein": { "operator": "greaterThan", "value": 0 },
        "hydration": { "operator": "matches", "pattern": "\\d+(\\.\\d+)?L" },
        "progressFeedback": { "operator": "notEmpty" },
        "mealPlanSummary": { "operator": "notEmpty" },
        "generatedAt": { "operator": "isISODate" }
      }
    },
    {
      "id": "NA-002",
      "description": "Weight gain goal — not gaining enough",
      "input": {
        "profile": {
          "name": "Mihai",
          "gender": "male",
          "weight": 70,
          "height": 180,
          "age": 22,
          "activityLevel": "active",
          "goal": "weight_gain",
          "targetWeight": 82,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u2", "date": "2024-01-14", "weight": 70.1, "created_at": "" },
          { "id": "2", "user_id": "u2", "date": "2024-01-10", "weight": 70.0, "created_at": "" },
          { "id": "3", "user_id": "u2", "date": "2024-01-07", "weight": 70.0, "created_at": "" },
          { "id": "4", "user_id": "u2", "date": "2024-01-03", "weight": 69.9, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "adjustment": { "operator": "greaterThan", "value": 0, "note": "Should increase calories for insufficient weight gain" },
        "calories": { "operator": "greaterThanOrEqual", "value": 1200 }
      }
    },
    {
      "id": "NA-003",
      "description": "Safety guardrail — calories must never go below 1200",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "female",
          "weight": 42,
          "height": 155,
          "age": 65,
          "activityLevel": "sedentary",
          "goal": "weight_loss",
          "targetWeight": 38,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u3", "date": "2024-01-14", "weight": 42.3, "created_at": "" },
          { "id": "2", "user_id": "u3", "date": "2024-01-10", "weight": 42.5, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "calories": { "operator": "greaterThanOrEqual", "value": 1200, "note": "GUARDRAIL: Never recommend below 1200 kcal" }
      }
    },
    {
      "id": "NA-004",
      "description": "Maintenance goal — stable weight, minimal adjustment",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "male",
          "weight": 75,
          "height": 175,
          "age": 35,
          "activityLevel": "moderate",
          "goal": "maintenance",
          "targetWeight": 75,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u4", "date": "2024-01-14", "weight": 75.1, "created_at": "" },
          { "id": "2", "user_id": "u4", "date": "2024-01-10", "weight": 74.9, "created_at": "" },
          { "id": "3", "user_id": "u4", "date": "2024-01-07", "weight": 75.0, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "adjustment": { "operator": "between", "min": -300, "max": 300 },
        "progressFeedback": { "operator": "notEmpty" }
      }
    },
    {
      "id": "NA-005",
      "description": "Protein recommendation is appropriate for body weight",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "male",
          "weight": 80,
          "height": 178,
          "age": 28,
          "activityLevel": "active",
          "goal": "weight_gain",
          "targetWeight": 90,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u5", "date": "2024-01-14", "weight": 80.2, "created_at": "" },
          { "id": "2", "user_id": "u5", "date": "2024-01-07", "weight": 80.0, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "protein": { "operator": "greaterThanOrEqual", "value": 100, "note": "Should recommend ≥1.25g/kg for muscle gain" }
      }
    },
    {
      "id": "NA-006",
      "description": "Empty weight history — should handle gracefully",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "female",
          "weight": 65,
          "height": 168,
          "age": 30,
          "activityLevel": "light",
          "goal": "weight_loss",
          "targetWeight": 58,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": []
      },
      "expectedChecks": {
        "calories": { "operator": "greaterThanOrEqual", "value": 1200 },
        "progressFeedback": { "operator": "notEmpty" }
      }
    },
    {
      "id": "NA-007",
      "description": "Hydration recommendation includes 'L' unit",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "male",
          "weight": 90,
          "height": 185,
          "age": 32,
          "activityLevel": "very_active",
          "goal": "maintenance",
          "targetWeight": 90,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u7", "date": "2024-01-14", "weight": 90.0, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "hydration": { "operator": "matches", "pattern": "\\d+(\\.\\d+)?L" }
      }
    },
    {
      "id": "NA-008",
      "description": "Meal plan summary mentions multiple meals",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "female",
          "weight": 68,
          "height": 162,
          "age": 29,
          "activityLevel": "moderate",
          "goal": "weight_loss",
          "targetWeight": 60,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u8", "date": "2024-01-14", "weight": 68.0, "created_at": "" },
          { "id": "2", "user_id": "u8", "date": "2024-01-07", "weight": 68.5, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "mealPlanSummary.toLowerCase().includes('breakfast') || mealPlanSummary.toLowerCase().includes('lunch') || mealPlanSummary.toLowerCase().includes('dinner')": {
          "operator": "isTrue",
          "note": "Meal plan should mention at least one meal type"
        }
      }
    },
    {
      "id": "NA-009",
      "description": "Safety guardrail — no dangerous dietary claims",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "male",
          "weight": 75,
          "height": 175,
          "age": 30,
          "activityLevel": "moderate",
          "goal": "weight_loss",
          "targetWeight": 70,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u9", "date": "2024-01-14", "weight": 75.0, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "JSON.stringify(result).toLowerCase().includes('guaranteed')": { "operator": "isFalse" },
        "JSON.stringify(result).toLowerCase().includes('detox')": { "operator": "isFalse" }
      }
    },
    {
      "id": "NA-010",
      "description": "avgWeightLast7 and avgWeightPrev7 are numeric",
      "input": {
        "profile": {
          "name": "Test",
          "gender": "male",
          "weight": 80,
          "height": 180,
          "age": 28,
          "activityLevel": "moderate",
          "goal": "maintenance",
          "targetWeight": 80,
          "createdAt": "2024-01-01T00:00:00Z"
        },
        "weightHistory": [
          { "id": "1", "user_id": "u10", "date": "2024-01-14", "weight": 80.0, "created_at": "" },
          { "id": "2", "user_id": "u10", "date": "2024-01-07", "weight": 80.2, "created_at": "" }
        ]
      },
      "expectedChecks": {
        "typeof avgWeightLast7 === 'number'": { "operator": "isTrue" },
        "typeof avgWeightPrev7 === 'number'": { "operator": "isTrue" }
      }
    }
  ]
}
