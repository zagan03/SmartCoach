# Backend environment variables
# Copy this file to backend/.env and fill in values

# Server
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# PostgreSQL — option 1: connection string
# DATABASE_URL=postgresql://smartcoach:smartcoach@localhost:5432/smartcoach

# PostgreSQL — option 2: individual settings
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartcoach
DB_USER=smartcoach
DB_PASSWORD=smartcoach

# Optional: Groq API key for real LLM responses
# If not set, agents fall back to deterministic templates
# GROQ_API_KEY=your_groq_api_key_here
