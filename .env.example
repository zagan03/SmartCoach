# Frontend environment variables
# Copy this file to .env and fill in values

# Backend API URL (local development)
VITE_API_BASE_URL=http://localhost:3001/api

# Optional: Groq API key (used by the backend, not the frontend)
# The backend reads GROQ_API_KEY from backend/.env
# These frontend vars are kept for reference only:
# VITE_GROQ_API_KEY=your_groq_api_key_here

# ── Firebase (NOT USED in local demo) ────────────────────────────────────────
# Firebase is disabled for the local demo. These vars are kept for reference.
# To re-enable Firebase, restore the original context files from git history.
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=
# VITE_FIREBASE_PROJECT_ID=
# VITE_FIREBASE_STORAGE_BUCKET=
# VITE_FIREBASE_MESSAGING_SENDER_ID=
# VITE_FIREBASE_APP_ID=
